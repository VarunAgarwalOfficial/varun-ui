{
  "name": "varunui",
  "private": false,
  "version": "0.1.0",
  "description": "An opinionated Svelte interface system in the pixel look.",
  "license": "MIT",
  "homepage": "https://varunui-preview-668817656353.australia-southeast1.run.app",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "DESIGN.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "npm run generate && vite dev",
    "build": "npm run generate && vite build",
    "start": "node build",
    "gcp-build": "npm run build",
    "preview": "vite preview",
    "prepare": "npm run generate && svelte-kit sync",
    "generate": "node scripts/registry/generate.mjs",
    "audit": "node scripts/registry/check-architecture.mjs && node scripts/registry/report-token-drift.mjs --strict && node scripts/registry/check-contrast.mjs && node scripts/registry/check-shell-tokens.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "package": "svelte-package",
    "validate": "npm run format:check && npm run generate && npm run audit && npm run check && npm run package && publint",
    "prepack": "npm run validate"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.69.1",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.2",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.1.0",
    "prettier": "^3.9.4",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "publint": "^0.3.21",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.2",
    "@tailwindcss/typography": "^0.5.20",
    "bits-ui": "^2.18.1",
    "bwip-js": "^4.11.2",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "phosphor-svelte": "^3.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "tailwindcss": "^4.0.0"
  },
  "overrides": {
    "postcss-selector-parser": "^6.1.5"
  }
}
